# HTTPS in front of MIA (service "https" of compose.yaml): the certificate comes from Caddy's own local CA, for whatever name or address is used.
# Browsers warn once; trust the CA to avoid it (deploy/README.md). Web sockets pass through, the Host header stays as the browser sent it.
{
	skip_install_trust
	default_sni localhost
}

https://:8586 {
	tls internal {
		on_demand
	}
	reverse_proxy mia:8585
}
