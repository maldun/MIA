{
  "name": "ollama",
  "docker": "docker",
  "port": 11434,
  "ollama_host": "http://ollama:11434",
  "ollama_managed": false,
  "ollama_wait": 600,
  "version": "gemma4:26b",
  "llm_options": {
    "num_ctx": 8192
  },
  "version_light": "gemma4:12b-it-qat",
  "llm_options_light": {
    "num_ctx": 8192
  },
  "default_profile": "light",
  "think": false,
  "keep_alive": "30m",
  "mode": "rocm",
  "timeout": 3,
  "web_port": 8585,
  "https_port": null,
  "sound_port": 8595,
  "address": "localhost",
  "protocol": "http",
  "kokoro_opts": {
    "voice": "af_heart",
    "speed": 1.0,
    "lang": "en-us"
  },
  "voice_effect": "anime",
  "sentence_pause": 0.3,
  "cpu_threads": null,
  "gfx_version": null,
  "history_file": "/opt/mia/MIA/data/memories.json",
  "long_time_history_file": "/opt/mia/MIA/data/long_time_history.json",
  "searxng_port": 8590,
  "searxng_autostart": false,
  "intro_sound": "voice/expressions/idle.wav",
  "intro_sounds": [
    "voice/expressions/Navi_Hello1.wav",
    "voice/expressions/Navi_Hey1.wav"
  ],
  "attention_sounds": [
    "voice/expressions/hey_listen.wav",
    "voice/expressions/Navi_Hey1.wav"
  ],
  "attention_chance": 0.3,
  "clock_interval": 3600,
  "time_before": "2 hour",
  "neutral_emotion": "disagree",
  "task_key": "TASK",
  "summary_words": 3000,
  "calibration_file": "data/calibration.txt",
  "max_conversations": 50,
  "search_backends": [
    "searxng",
    "duckduckgo"
  ],
  "searxng_url": "http://searxng:8080",
  "search_results": 8,
  "search_results_shown": 5,
  "web_timeout": [
    5,
    15
  ],
  "web_max_bytes": 2000000,
  "web_max_chars": 30000,
  "research_pipeline": null,
  "sandbox_backend": "none",
  "sandbox_degrade": false,
  "sandbox_image": "localhost/mia-sandbox:1",
  "skills_dir": "skills",
  "library_dir": "library",
  "user_library_dir": "data/library",
  "library_index": "data/library.sqlite",
  "runs_dir": "data/runs",
  "host": "0.0.0.0",
  "shutdown_pause": 1.0,
  "character_dir": "ui/godot/build/web",
  "presets_dir": "data/presets",
  "gestures_dir": "data/gestures",
  "editor_token_file": "data/editor_token.txt",
  "background_dir": "backgrounds",
  "background_image": null,
  "chat_log": "data/chat_log.jsonl",
  "chat_log_max_messages": 10000,
  "chat_queue": 1,
  "chat_rate_per_minute": 10,
  "moods_file": "moods.json",
  "mood_hold_minutes": 10,
  "expression_model": null,
  "expression_temperature": 0.7,
  "feedback_log": "data/feedback_log.jsonl",
  "tailscale": false,
  "public_hosts": [],
  "trusted_proxies": ["https"],
  "tts_warmup": true
}
