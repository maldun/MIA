{
 "id": "research.typed",
 "version": 1,
 "title": "Research with a typed plan: ordered lookups with substitution, operations by code",
 "description": "13b ST10: the model writes a typed plan; if it is sound, the steps run in order (a lookup whose entity is #n is searched with the value of step n, every lookup answered with a quote and a bare value that stands in the quote), operations are done by code, the answer is composed from the verified facts and the calculation and its quotes are checked again. A plan that is not sound (or a simple question) gives unknown here; research.escalate@3 uses the cheap try and the decomposition around it.",
 "goal": "an answer with quotes, or unknown",
 "tags": [
  "research",
  "strategy",
  "typed"
 ],
 "applies_to": {
  "tasks": [
   "research"
  ]
 },
 "cost_class": "expensive",
 "result": "answer",
 "inputs": {
  "schema": {
   "type": "object",
   "required": [
    "question"
   ],
   "properties": {
    "question": {
     "type": "string"
    }
   }
  }
 },
 "nodes": [
  {
   "id": "draw",
   "use": "view.typed_plan@1",
   "wire": {
    "question": "$input.question"
   },
   "output": "tplan"
  },
  {
   "id": "dcheck",
   "use": "code.check_typed_plan@1",
   "wire": {
    "plan": "$tplan",
    "question": "$input.question"
   },
   "output": "tchecked"
  },
  {
   "id": "dvalid",
   "kind": "branch",
   "plain": "is the plan sound",
   "if": {
    "ref": "tchecked.valid",
    "op": "true"
   },
   "then": [
    {
     "id": "tstart",
     "use": "code.typed_start@1",
     "wire": {},
     "output": "values"
    },
    {
     "id": "tsteps",
     "kind": "loop",
     "max": 9,
     "plain": "running the steps",
     "until": {
      "ref": "cur.done",
      "op": "true"
     },
     "body": [
      {
       "id": "tprep",
       "use": "code.typed_prepare@1",
       "wire": {
        "plan": "$tplan",
        "values": "$values",
        "question": "$input.question"
       },
       "output": "cur"
      },
      {
       "id": "twork",
       "kind": "branch",
       "plain": "running a step",
       "if": {
        "ref": "cur.done",
        "op": "false"
       },
       "then": [
        {
         "id": "twhich",
         "kind": "branch",
         "plain": "a lookup or an operation",
         "if": {
          "ref": "cur.kind",
          "op": "==",
          "value": "lookup"
         },
         "then": [
          {
           "id": "tsearch1",
           "use": "tool.web_search@1",
           "wire": {
            "query": "$cur.query"
           },
           "output": "thits1",
           "plain": "searching for: {{cur.query}}"
          },
          {
           "id": "tpick1",
           "use": "code.top_urls@2",
           "wire": {
            "hits": "$thits1"
           },
           "output": "turls1"
          },
          {
           "id": "tread1",
           "kind": "map",
           "over": "$turls1",
           "as": "address",
           "collect": "page",
           "workers": 1,
           "plain": "reading the pages",
           "output": "tpages1",
           "body": [
            {
             "id": "tfetch1",
             "use": "tool.fetch_page@1",
             "wire": {
              "url": "$address"
             },
             "output": "page",
             "on_error": "skip",
             "plain": "reading {{address}}"
            }
           ]
          },
          {
           "id": "tpassages1",
           "use": "code.collect_passages@1",
           "wire": {
            "question": "$cur.question",
            "pages": "$tpages1"
           },
           "output": "tmaterial1"
          },
          {
           "id": "twrite1",
           "use": "view.answer_with_value@1",
           "wire": {
            "question": "$cur.question",
            "context": "$tmaterial1.context"
           },
           "output": "tdraft1"
          },
          {
           "id": "tcheck1",
           "use": "code.anchor_answer@1",
           "wire": {
            "answer": "$tdraft1",
            "passages": "$tmaterial1.passages"
           },
           "output": "attempt"
          },
          {
           "id": "tretry",
           "kind": "branch",
           "plain": "the first search did not answer",
           "if": {
            "ref": "attempt.status",
            "op": "!=",
            "value": "answered"
           },
           "then": [
            {
             "id": "trequery",
             "use": "view.requery@1",
             "wire": {
              "question": "$cur.question",
              "previous_query": "$cur.query",
              "note": "$attempt.answer"
             },
             "output": "tnewquery"
            },
            {
             "id": "tsearch2",
             "use": "tool.web_search@1",
             "wire": {
              "query": "$tnewquery.query"
             },
             "output": "thits2",
             "plain": "searching again for: {{tnewquery.query}}"
            },
            {
             "id": "tpick2",
             "use": "code.top_urls@2",
             "wire": {
              "hits": "$thits2",
              "exclude": "$turls1"
             },
             "output": "turls2"
            },
            {
             "id": "tread2",
             "kind": "map",
             "over": "$turls2",
             "as": "address",
             "collect": "page",
             "workers": 1,
             "plain": "reading the pages",
             "output": "tpages2",
             "body": [
              {
               "id": "tfetch2",
               "use": "tool.fetch_page@1",
               "wire": {
                "url": "$address"
               },
               "output": "page",
               "on_error": "skip",
               "plain": "reading {{address}}"
              }
             ]
            },
            {
             "id": "tpassages2",
             "use": "code.collect_passages@1",
             "wire": {
              "question": "$cur.question",
              "pages": "$tpages2"
             },
             "output": "tmaterial2"
            },
            {
             "id": "twrite2",
             "use": "view.answer_with_value@1",
             "wire": {
              "question": "$cur.question",
              "context": "$tmaterial2.context"
             },
             "output": "tdraft2"
            },
            {
             "id": "tcheck2",
             "use": "code.anchor_answer@1",
             "wire": {
              "answer": "$tdraft2",
              "passages": "$tmaterial2.passages"
             },
             "output": "attempt"
            }
           ]
          },
          {
           "id": "trecord",
           "use": "code.typed_lookup_record@1",
           "wire": {
            "values": "$values",
            "current": "$cur",
            "attempt": "$attempt"
           },
           "output": "values"
          }
         ],
         "else": [
          {
           "id": "toperate",
           "use": "code.typed_other@1",
           "wire": {
            "values": "$values",
            "current": "$cur"
           },
           "output": "values"
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "id": "tsummary",
     "use": "code.typed_summary@1",
     "wire": {
      "plan": "$tplan",
      "values": "$values",
      "question": "$input.question"
     },
     "output": "ttable"
    },
    {
     "id": "tcompose",
     "use": "view.compose_answer@1",
     "wire": {
      "question": "$input.question",
      "facts": "$ttable.context",
      "calculation": "$ttable.calculation"
     },
     "output": "composed"
    },
    {
     "id": "tanchor",
     "use": "code.anchor_answer@1",
     "wire": {
      "answer": "$composed",
      "passages": "$ttable.passages"
     },
     "output": "answer"
    }
   ],
   "else": [
    {
     "id": "nothing",
     "use": "code.only_result@1",
     "wire": {
      "results": []
     },
     "output": "answer"
    }
   ]
  }
 ],
 "status": "draft",
 "origin": {
  "by": "manual",
  "parent": "research.decompose@2",
  "note": "variant C; not measured yet"
 }
}
