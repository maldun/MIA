{
 "id": "verify.cops",
 "version": 1,
 "title": "Good cop and bad cop",
 "description": "One voice argues for the claim, one against it, a third (the judge) reads both and decides. Two calls that cannot see each other plus one that sees both.",
 "goal": "judge a claim that no hard check can decide",
 "tags": [
  "verify",
  "style"
 ],
 "applies_to": {
  "claim_types": [
   "fact"
  ],
  "tasks": [
   "research"
  ]
 },
 "cost_class": "normal",
 "inputs": {
  "schema": {
   "type": "object",
   "required": [
    "claim",
    "evidence"
   ],
   "properties": {
    "claim": {
     "type": "string"
    },
    "evidence": {
     "type": "string",
     "description": "sources or notes, may be empty"
    }
   }
  }
 },
 "result": "verdict",
 "nodes": [
  {
   "id": "pro",
   "use": "view.argue@1",
   "wire": {
    "claim": "$input.claim",
    "evidence": "$input.evidence",
    "side": "for"
   },
   "output": "case_for"
  },
  {
   "id": "con",
   "use": "view.argue@1",
   "wire": {
    "claim": "$input.claim",
    "evidence": "$input.evidence",
    "side": "against"
   },
   "output": "case_against"
  },
  {
   "id": "judge",
   "use": "view.judge@1",
   "wire": {
    "claim": "$input.claim",
    "evidence": "$input.evidence",
    "case_for": "$case_for.points",
    "case_against": "$case_against.points"
   },
   "output": "ruling"
  },
  {
   "id": "count",
   "use": "code.tally@1",
   "wire": {
    "verdicts": "$ruling"
   },
   "output": "verdict"
  }
 ],
 "status": "draft",
 "origin": {
  "by": "manual",
  "note": "verification style; wiring tested with scripted replies, not measured with a real model yet"
 }
}
