{"id": "c-real-quote", "tags": ["citation"], "claim": {"type": "citation", "text": "cited: https://encyclopedia.example/eiffel", "data": {"url": "https://encyclopedia.example/eiffel", "quote": "wrought-iron lattice tower in Paris"}}, "expect": "pass", "truth": true}
{"id": "c-quote-across-markup", "tags": ["citation", "normalisation"], "claim": {"type": "citation", "text": "cited: https://encyclopedia.example/eiffel", "data": {"url": "https://encyclopedia.example/eiffel", "quote": "is 330 metres tall"}}, "expect": "pass", "truth": true, "note": "the number is bold in the page: markup is not part of the text"}
{"id": "c-quote-not-on-page", "tags": ["citation"], "claim": {"type": "citation", "text": "cited: https://encyclopedia.example/eiffel", "data": {"url": "https://encyclopedia.example/eiffel", "quote": "The Eiffel Tower is made of solid gold"}}, "expect": "fail", "truth": false}
{"id": "c-near-quote", "tags": ["citation", "near-miss", "trap"], "claim": {"type": "citation", "text": "cited: https://encyclopedia.example/eiffel", "data": {"url": "https://encyclopedia.example/eiffel", "quote": "It was completed on 31 March 1888 and is 330 metres tall."}}, "expect": "open", "truth": false, "note": "one number differs"}
{"id": "c-hidden-text", "tags": ["citation", "trap", "hidden"], "claim": {"type": "citation", "text": "cited: https://encyclopedia.example/eiffel", "data": {"url": "https://encyclopedia.example/eiffel", "quote": "the tower is 12 metres wide and made of gold"}}, "expect": "fail", "truth": false, "note": "the text exists only in an invisible element: no reader can see it"}
{"id": "c-page-gone", "tags": ["citation", "trap"], "claim": {"type": "citation", "text": "cited: https://gone.example.com/removed", "data": {"url": "https://gone.example.com/removed", "quote": "anything at all"}}, "expect": "fail", "truth": false, "note": "404: a citation that does not exist"}
{"id": "c-server-busy", "tags": ["citation"], "claim": {"type": "citation", "text": "cited: https://flaky.example.com/page", "data": {"url": "https://flaky.example.com/page", "quote": "anything at all"}}, "expect": "open", "note": "503 says nothing about the page"}
{"id": "c-timeout", "tags": ["citation"], "claim": {"type": "citation", "text": "cited: https://slow.example.com/page", "data": {"url": "https://slow.example.com/page", "quote": "anything at all"}}, "expect": "open"}
{"id": "c-unknown-host", "tags": ["citation"], "claim": {"type": "citation", "text": "cited: https://no-such-host.example/page", "data": {"url": "https://no-such-host.example/page", "quote": "anything at all"}}, "expect": "open", "note": "a host that cannot be reached is not proof that the page never existed"}
{"id": "c-pdf-not-read", "tags": ["citation", "known_limit"], "claim": {"type": "citation", "text": "cited: https://paper.example.org/report.pdf", "data": {"url": "https://paper.example.org/report.pdf", "quote": "anything at all"}}, "expect": "open", "note": "the check cannot read PDFs yet"}
{"id": "c-search-page", "tags": ["citation", "trap"], "claim": {"type": "citation", "text": "cited: https://www.google.com/search?q=eiffel+tower+height", "data": {"url": "https://www.google.com/search?q=eiffel+tower+height", "quote": "330 metres"}}, "expect": "fail", "truth": false, "note": "a search results page is not a source"}
{"id": "c-local-address", "tags": ["citation", "security"], "claim": {"type": "citation", "text": "cited: http://127.0.0.1:8585/api/presets", "data": {"url": "http://127.0.0.1:8585/api/presets", "quote": "anything at all"}}, "expect": "fail", "truth": false}
{"id": "c-private-address", "tags": ["citation", "security"], "claim": {"type": "citation", "text": "cited: http://192.168.0.1/admin", "data": {"url": "http://192.168.0.1/admin", "quote": "anything at all"}}, "expect": "fail", "truth": false}
{"id": "c-redirect-to-private", "tags": ["citation", "security"], "claim": {"type": "citation", "text": "cited: https://evil.example.com/redirect", "data": {"url": "https://evil.example.com/redirect", "quote": "anything at all"}}, "expect": "fail", "truth": false, "note": "a redirect into the local network is refused"}
{"id": "c-redirect-to-page", "tags": ["citation"], "claim": {"type": "citation", "text": "cited: https://short.example.com/moved", "data": {"url": "https://short.example.com/moved", "quote": "wrought-iron lattice tower"}}, "expect": "pass", "truth": true, "note": "a normal redirect is followed"}
{"id": "c-title-matches", "tags": ["citation"], "claim": {"type": "citation", "text": "cited: https://encyclopedia.example/eiffel", "data": {"url": "https://encyclopedia.example/eiffel", "title": "Eiffel Tower - Encyclopedia"}}, "expect": "pass", "truth": true}
{"id": "c-title-differs", "tags": ["citation", "trap"], "claim": {"type": "citation", "text": "cited: https://encyclopedia.example/eiffel", "data": {"url": "https://encyclopedia.example/eiffel", "title": "Ten ways to cook pasta at home"}}, "expect": "open", "truth": false, "note": "a page that exists but is not what was cited"}
{"id": "c-long-page-quote-late", "tags": ["citation", "clipped"], "claim": {"type": "citation", "text": "cited: https://long.example.com/article", "data": {"url": "https://long.example.com/article", "quote": "the author thanks the translator"}}, "expect": "open", "truth": true, "note": "the page is clipped before the quote: absence cannot be shown"}
{"id": "c-long-page-quote-early", "tags": ["citation"], "claim": {"type": "citation", "text": "cited: https://long.example.com/article", "data": {"url": "https://long.example.com/article", "quote": "Start of the article"}}, "expect": "pass", "truth": true}
{"id": "w-two-independent-sources", "tags": ["fact", "web_confirm"], "claim": {"type": "fact", "text": "The Eiffel Tower was completed in 1889", "data": {"entities": ["Eiffel Tower", "1889"], "facts": ["1889"]}}, "expect": "pass", "truth": true}
{"id": "w-mirrors-count-once", "tags": ["fact", "web_confirm", "mirror"], "claim": {"type": "fact", "text": "The Eiffel Tower is 330 metres tall", "data": {"entities": ["Eiffel Tower", "tall"], "facts": ["330 metres"]}}, "expect": "open", "truth": true, "note": "the second source is a copy of the first"}
{"id": "w-third-source-saves-it", "tags": ["fact", "web_confirm"], "claim": {"type": "fact", "text": "The Eiffel Tower is 330 metres tall", "data": {"entities": ["Eiffel Tower", "330 metres"], "facts": ["330 metres"]}}, "expect": "pass", "truth": true, "note": "blog and encyclopedia agree; the news page does not contain the number"}
{"id": "w-fact-not-in-sources", "tags": ["fact", "web_confirm", "trap"], "claim": {"type": "fact", "text": "The Eiffel Tower is 400 metres tall", "data": {"entities": ["Eiffel Tower", "400 metres"], "facts": ["400 metres"]}}, "expect": "open", "truth": false, "note": "nothing confirms it: the check abstains and does not call the claim false"}
{"id": "w-nothing-found", "tags": ["fact", "web_confirm"], "claim": {"type": "fact", "text": "The tower of Unknownville was finished in the year 1066", "data": {"entities": ["Unknown Tower", "1066"], "facts": ["1066"]}}, "expect": "open", "note": "no results at all is not a refutation"}
{"id": "w-correction-found", "tags": ["fact", "web_confirm", "trap", "myth"], "claim": {"type": "fact", "text": "The Great Wall is visible from space", "data": {"entities": ["Great Wall", "visible from space"], "facts": ["visible from space"]}}, "expect": "open", "truth": false, "note": "two sources repeat the myth, but the disconfirming search finds the debunking"}
{"id": "w-popular-myth-no-correction", "tags": ["fact", "web_confirm", "myth", "known_limit"], "claim": {"type": "fact", "text": "The Great Wall is visible from space", "data": {"entities": ["Great Wall", "visible from space", "naked eye"], "facts": ["visible from space"]}}, "expect": "pass", "truth": false, "note": "KNOWN LIMIT: two independent sources repeat a popular myth and the disconfirming search (a different query here) finds no correction: web confirmation passes a false claim"}
{"id": "w-hostile-sources", "tags": ["fact", "web_confirm", "security"], "claim": {"type": "fact", "text": "The Eiffel Tower was completed in 1889", "data": {"entities": ["Eiffel Tower", "completed"], "facts": ["1889"]}}, "expect": "pass", "truth": true, "note": "both pages contain instructions aimed at models; the facts are read as data and the instructions are only flagged"}
{"id": "w-one-source-is-gone", "tags": ["fact", "web_confirm"], "claim": {"type": "fact", "text": "The Eiffel Tower opened in 1889", "data": {"entities": ["Eiffel Tower", "opened"], "facts": ["1889"]}}, "expect": "pass", "truth": true, "note": "one result is a dead link; two others agree"}
{"id": "w-query-is-the-claim", "tags": ["fact", "web_confirm", "trap"], "claim": {"type": "fact", "text": "The Eiffel Tower was completed in 1889", "data": {"entities": ["The", "Eiffel", "Tower", "was", "completed", "in", "1889"], "facts": ["1889"]}}, "expect": "not_applicable", "note": "a query that repeats the wording of the claim tests the claim against itself"}
{"id": "w-private-results-are-dropped", "tags": ["fact", "web_confirm", "security"], "claim": {"type": "fact", "text": "There is an administration page for the tower", "data": {"entities": ["tower", "admin"], "facts": ["admin"]}}, "expect": "open", "note": "results that point into the local network are not followed"}
{"id": "w-no-entities", "tags": ["fact", "web_confirm"], "claim": {"type": "fact", "text": "something", "data": {"entities": []}}, "expect": "not_applicable"}
