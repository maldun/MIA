        "wire": {
         "plan": "$rawplan",
         "question": "$input.question"
        }
       },
       {
        "as": "sub",
        "body": [
         {
          "id": "search1",
          "output": "hits1",
          "plain": "searching for: {{sub.query}}",
          "use": "tool.web_search@1",
          "wire": {
           "query": "$sub.query"
          }
         },
         {
          "id": "pick1",
