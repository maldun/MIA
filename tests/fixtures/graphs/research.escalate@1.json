          "plain": "reading the pages",
          "workers": 1
         },
         {
          "id": "passages1",
          "output": "material1",
          "use": "code.collect_passages@1",
          "wire": {
           "pages": "$pages1",
           "question": "$sub.question"
          }
         },
         {
          "id": "write1",
          "output": "draft1",
          "use": "view.answer_from_passages@1",
          "wire": {
           "context": "$material1.context",
           "question": "$sub.question"
          }
         },
         {
          "id": "check1",
          "output": "attempt",
          "use": "code.anchor_answer@1",
          "wire": {
           "answer": "$draft1",
           "passages": "$material1.passages"
          }
         },
         {
          "id": "retry",
          "if": {
           "op": "!=",
           "ref": "attempt.status",
           "value": "answered"
          },
          "kind": "branch",
          "plain": "the first search did not answer",
          "then": [
           {
            "id": "requery",
            "output": "newquery",
            "use": "view.requery@1",
            "wire": {
             "note": "$attempt.answer",
             "previous_query": "$sub.query",
             "question": "$sub.question"
            }
           },
           {
            "id": "search2",
            "output": "hits2",
            "plain": "searching again for: {{newquery.query}}",
            "use": "tool.web_search@1",
            "wire": {
             "query": "$newquery.query"
            }
           },
           {
            "id": "pick2",
            "output": "urls2",
            "use": "code.top_urls@2",
            "wire": {
             "exclude": "$urls1",
             "hits": "$hits2"
            }
           },
           {
            "as": "address",
            "body": [
             {
              "id": "fetch2",
              "on_error": "skip",
              "output": "page",
