          "then": [
           {
            "id": "ask_calc",
            "output": "request",
            "use": "view.calc_request@1",
            "wire": {
             "facts": "$table.context",
             "question": "$input.question"
            }
           },
           {
            "id": "do_calc",
            "output": "calculation",
            "use": "code.calculate@1",
            "wire": {
             "request": "$request"
            }
           }
          ]
         },
         {
          "id": "compose",
          "output": "composed",
          "use": "view.compose_answer@1",
          "wire": {
           "calculation": "$calculation.text",
           "facts": "$table.context",
           "question": "$input.question"
          }
         },
         {
          "id": "anchor",
          "output": "answer",
          "use": "code.anchor_answer@1",
          "wire": {
           "answer": "$composed",
           "passages": "$table.passages"
          }
         }
        ],
        "id": "finish",
        "if": {
         "all": [
          {
           "op": "true",
           "ref": "plan.single"
          },
          {
           "op": "false",
           "ref": "plan.needs_calculation"
          }
         ]
        },
        "kind": "branch",
        "plain": "composing the answer",
        "then": [
         {
          "id": "only",
          "output": "answer",
          "use": "code.only_result@1",
          "wire": {
           "results": "$results"
          }
         }
        ]
       }
      ]
     }
    }
   },
   "id": "settings.escalate"
