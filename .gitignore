# user data: expression presets saved with the editor
data/
__pycache__/

# rendered lines of MIA voice (one file per line, removed after a while)
templates/audio/line-*.wav

# SearXNG settings with the generated secret key
tools/searxng/settings.local.yml

# the real configuration of this machine (setup_cfg.example.json is the tracked template; MIA copies it on the first start)
setup_cfg.json

# the voice model of Kokoro (downloaded, see README.md; the folder is kept by its placeholder file) and the samples of voice_lab.py
voice/models/kokoro/*
!voice/models/kokoro/.kokoro_models_here
voice/samples/lab/
# the voice lines of the moods: made on each machine by tools/make_voice_lines.py (deploy/RUNBOOK.md), never committed
voice/expressions/*.wav

# the Blender source of the 3D character and Blender's backups: not shared (ui/character/README.md)
*.blend
*.blend1
*.blend2

# the 3D character as zip files that travel outside git (ui/tools/character_pack.py; the manifest next to them is tracked)
ui/character/*.zip

# own pictures behind the character (backgrounds/README.md; the folder is kept by its README) and the personality text of MIA (README.md, "calibration.txt")
backgrounds/*
!backgrounds/README.md
calibration.txt

# suites
eval/suites/verdicts_vitaminc*/

# log of a running MIA (the test runs in the container write it into the checkout)
mia.log
out.wav
local-tasks.jsonl
.local-tasks/

.venv-gate/
.stages/
# editor autosave and lock files (Emacs, Kate)
\#*#
.#*

# personal runtime data of MIA (memories and conversation history, with their .old copies) and local backups
memories.json
long_time_history.json
*.old
mia-backup-*.tar.gz
testmsg.txt
in.wav

# local media of the page and the character: the videos made in vids/ and the site files that stay on this machine (templates/static/.site_stuff_goes_here)
vids/
templates/static/*.mp4
templates/static/background.jpg
templates/static/favicon.ico
# leftovers of the old page (removed code, see ui/README.md; the vendored libraries are in templates/static/vendor/)
templates/static/answer.html
templates/static/md-block.js.js
templates/static/socket.io.min.js
templates/node_modules/

# voice models and samples downloaded or made on this machine
voice/models/MikuAI/
voice/models/mitchieMmiku/
voice/samples/miku*.wav
voice/expressions.zip

# draw.io backup and lock files
.$*
