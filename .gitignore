# user data: expression presets saved with the editor
data/
__pycache__/

# rendered lines of MIA voice (one file per line, removed after a while)
templates/audio/line-*.wav

# SearXNG settings with the generated secret key
tools/searxng/settings.local.yml

# the real configuration of this machine (setup_cfg.example.json is the tracked template; MIA copies it on the first start)
setup_cfg.json

# the voice model of Kokoro (downloaded, see README.md; the folder is kept by its placeholder file) and the samples of voice_lab.py
voice/models/kokoro/*
!voice/models/kokoro/.kokoro_models_here
voice/samples/lab/

# the Blender source of the 3D character and Blender's backups: not shared (ui/character/README.md)
*.blend
*.blend1
*.blend2

# the 3D character as zip files that travel outside git (ui/tools/character_pack.py; the manifest next to them is tracked)
ui/character/*.zip

# own pictures behind the character (backgrounds/README.md; the folder is kept by its README) and the personality text of MIA (README.md, "calibration.txt")
backgrounds/*
!backgrounds/README.md
calibration.txt

# suites
eval/suites/verdicts_vitaminc*/

# log of a running MIA (the test runs in the container write it into the checkout)
mia.log
