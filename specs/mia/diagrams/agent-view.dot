digraph C {
rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=10, shape=box];
label="Agent view: untrusted text into model steps (orange = model step, grey = code, label = trust boundary)"; labelloc=t; fontsize=16;
"intake" [label="intake", style=filled, fillcolor="#e6e6e6"];
"fetcher" [label="fetcher", style=filled, fillcolor="#e6e6e6"];
"scholar" [label="scholar", style=filled, fillcolor="#e6e6e6"];
