"observability" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>observability</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">runLog</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">contentStore</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">contextGraph</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">explainTool</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">reproducer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">webLog</TD></TR></TABLE>>];
"evaluation" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>evaluation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">harness</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">suites</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">judgeCalibration</TD></TR></TABLE>>];
"learning" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>learning</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">router</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">banditOverVariants</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699">approvalGate</TD></TR></TABLE>>];
"persistence" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>persistence</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">files</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">storageLayer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">database</TD></TR></TABLE>>];
"operation" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>operation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">configuration</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">launcher</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">shutdownSequence</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">httpsAccess</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">composeStack</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699">characterTools</TD></TR></TABLE>>];
"legend" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD><B>legend</B></TD></TR><TR><TD BGCOLOR="#b7e1b0">built (45)</TD></TR><TR><TD BGCOLOR="#ffe699">partly (9)</TD></TR><TR><TD BGCOLOR="#a9c8ee">proposed (14)</TD></TR><TR><TD BGCOLOR="#d0d0d0">postponed (0)</TD></TR><TR><TD BGCOLOR="#f4b6b6">dropped (0)</TD></TR></TABLE>>];
{ rank=same; "frontEnd"; "webApp"; "graphApp"; "conversation"; }
"frontEnd" -> "webApp";
"webApp" -> "graphApp";
"graphApp" -> "conversation";
"frontEnd" -> "taskRuntime";
{ rank=same; "taskRuntime"; "verifier"; "research"; "voice"; }
"taskRuntime" -> "verifier";
"verifier" -> "research";
"research" -> "voice";
"taskRuntime" -> "observability";
{ rank=same; "observability"; "evaluation"; "learning"; "persistence"; }
"observability" -> "evaluation";
"evaluation" -> "learning";
"learning" -> "persistence";
"observability" -> "operation";
{ rank=same; "operation"; "legend"; }
"operation" -> "legend";
}