digraph A {
rankdir=TB; fontname="Helvetica"; node [shape=plain, fontname="Helvetica", fontsize=10]; edge [style=invis];
label="MIA: subsystems and parts (colour = status in the code base)"; labelloc=t; fontsize=16;
"frontEnd" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>frontEnd</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">chatPage</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">characterRenderer</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">expressionEditor</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">hostBridge</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">audioPlayer</TD></TR></TABLE>>];
"webApp" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>webApp</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">chatService</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">chatLog</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">moodTracker</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">presetsApi</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">accessControl</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">accountService</TD></TR></TABLE>>];
