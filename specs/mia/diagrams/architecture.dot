"conversation" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>conversation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">communicator</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">expressor</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699">behaviourRules</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699">memory</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699">scheduleReminders</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699">persona</TD></TR></TABLE>>];
"taskRuntime" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>taskRuntime</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">skillStore</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">pipelineRunner</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">libraryStore</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">planner</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">workflowGraph</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">storytelling</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">modelManager</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">skillScaffold</TD></TR></TABLE>>];
"verifier" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>verifier</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">hardChecks</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699">verificationStyles</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">sandbox</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">webBroker</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">claimExtractor</TD></TR></TABLE>>];
"research" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#444444"><FONT COLOR="white"><B>research</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">webTools</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">lookup</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">scholarClients</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">sourceTrust</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">reviewRequest</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#b7e1b0">pdfReader</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699">reviewCases</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">reviewPipeline</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#a9c8ee">methodTransfer</TD></TR></TABLE>>];
