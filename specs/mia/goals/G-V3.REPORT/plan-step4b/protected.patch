+    @mark.req("REQ-CLV-048", "REQ-CLV-049")
+    def test_the_report_part_shows_the_report_with_a_download(self):
+        """TC-CLV-048: after a /lookup that ends with a report file the Report part is listed with the state in its summary line, opens to the rendered report and its download link is /api/files/<name> and returns the file byte for byte.
+        Example: the source "https://gazette.example/x?a=1" is a link, "A book, p. 12" is text, the download is /api/files/lookup-2026-11-08-canary-releases.md."""
+        # Given: a finished /lookup whose report file holds a source with an address and one without
+        out = self.got("report")
+        # When: the Full run part and the Report part are opened
+        # Then: the Report part is listed and its summary line has the state of the run
+        self.assertTrue(out["listed"])
+        self.assertEqual(out["state"], "done")
+        self.assertTrue(out["summary"])
+        # And: the source with an address is a link that opens in a new tab, the one without stays text
+        self.assertEqual([(link["href"], link["target"]) for link in out["links"]], [("https://gazette.example/x?a=1", "_blank")])
+        self.assertTrue({"noopener", "noreferrer"} <= set(out["links"][0]["rel"].split()))
+        self.assertIn("A book, p. 12", out["body"] or "")
+        # And: the download link is /api/files/<name> and returns the file byte for byte
+        self.assertEqual(out["href"], "/api/files/lookup-2026-11-08-canary-releases.md")
+        self.assertEqual(out["fetched"], REPORT_MD)
+
+    @mark.req("REQ-CLV-050")
+    def test_the_report_part_waits_for_the_end_of_the_run(self):
+        """TC-CLV-050: while the run goes the Report part says that the report comes when the run ends and has no link; after the end it shows the report without a reload.
+        Example: a running lookup shows the waiting sentence; when it ends the source link appears on the same page."""
+        # Given: a lookup that is still running
+        out = self.got("report_wait")
+        # When: the Report part is opened, then the run ends
+        # Then: before the end it shows the waiting sentence and no link
+        self.assertEqual(out["before"], {"note": "waiting", "downloads": 0, "links": 0})
+        # And: after the end the note is gone, the report and its download are there, and the page was not reloaded
+        self.assertIsNone(out["after"]["note"])
+        self.assertEqual((out["after"]["downloads"], out["after"]["links"], out["after"]["same_page"]), (1, 1, True))
+
+    @mark.req("REQ-CLV-051")
+    def test_the_report_part_says_that_the_file_was_removed(self):
+        """TC-CLV-051: a finished run whose report file is not in the files volume shows the removed sentence and no link, and the rest of the Full run is unchanged.
+        Example: the result "It opened on 3 May 2021." is still shown, the Report part says that the file was removed."""
+        # Given: a finished run whose report file is not in the volume
+        out = self.got("report_gone")
